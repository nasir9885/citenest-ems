# EMS PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=citenest_ems
DB_USER=citenest_ems
DB_PASSWORD=REPLACE_WITH_EMS_DATABASE_PASSWORD

# EMS Authentik OIDC
AUTHENTIK_ISSUER=http://localhost:9000/application/o/cite-nest-ems-local/
AUTHENTIK_CLIENT_ID=REPLACE_WITH_EMS_CLIENT_ID
AUTHENTIK_CLIENT_SECRET=REPLACE_WITH_EMS_CLIENT_SECRET
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SESSION_SECRET

# Server-only Authentik user-management integration.
# Use a dedicated least-privilege service-account API token. Never expose it to the browser.
AUTHENTIK_API_URL=http://localhost:9000/api/v3/
AUTHENTIK_API_TOKEN=REPLACE_WITH_SERVICE_ACCOUNT_API_TOKEN

# Private employee uploads (mount this path as a persistent volume in production)
EMS_UPLOAD_DIR=.data/uploads
